# -----------------------------------------------------------------------------
# Environment variables
# Copy this file to `.env` and adjust the values: `cp .env.example .env`
# Never commit `.env`. Every value below is a safe default for local development.
# When you add a variable to the code, document it here in the same pull request.
# -----------------------------------------------------------------------------

# --- General ------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Log verbosity: error | warn | info | debug
LOG_LEVEL=debug

# Turns on developer mode: controller simulator, message log, latency display
DEV_MODE=true

# --- Real-time server -----------------------------------------------------------

# Port the real-time server listens on
SERVER_PORT=3000

# Comma-separated list of origins allowed to connect (console and controller URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Maximum number of players in one room (the platform supports up to 8)
MAX_PLAYERS_PER_ROOM=8

# A room with no activity for this long is closed automatically (seconds)
ROOM_IDLE_TIMEOUT_SECONDS=900

# How long a disconnected player keeps their slot before being removed (seconds)
RECONNECT_GRACE_SECONDS=60

# Maximum number of messages one player may send per second (anti-abuse)
RATE_LIMIT_MESSAGES_PER_SECOND=60

# --- Console and controller (exposed to the browser) ----------------------------

# Port of the console dev server
CONSOLE_PORT=5173

# Port of the controller dev server
CONTROLLER_PORT=5174

# URL the console and the controller use to reach the real-time server
VITE_SERVER_URL=http://localhost:3000

# Public URL of the controller, encoded in the room QR code.
# To play with a real phone on your local network, replace localhost with your
# computer's local IP address, e.g. http://192.168.1.42:5174
VITE_CONTROLLER_URL=http://localhost:5174

# --- Accounts (optional feature) ------------------------------------------------

# PostgreSQL connection string. The default matches the Docker Compose database.
DATABASE_URL=postgresql://console:console@localhost:5432/console

# Secret used to sign session cookies. Use a long random string in production,
# stored in GitHub Secrets / the host's secret manager, never in this file.
SESSION_SECRET=change-me-in-production
