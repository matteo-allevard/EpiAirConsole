{
  "name": "byoc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-env.mjs",
    "predev": "npm run check",
    "dev": "concurrently --names server,console,controller --prefix-colors blue,magenta,green --kill-others-on-fail \"npm:dev:server\" \"npm:dev:console\" \"npm:dev:controller\"",
    "predev:host": "npm run check",
    "dev:host": "concurrently --names server,console,controller --prefix-colors blue,magenta,green --kill-others-on-fail \"npm:dev:server\" \"npm run dev -w @byoc/console -- --host\" \"npm run dev -w @byoc/controller -- --host\"",
    "dev:server": "npm run dev -w @byoc/server",
    "dev:console": "npm run dev -w @byoc/console",
    "dev:controller": "npm run dev -w @byoc/controller",
    "test": "npm test --workspaces --if-present && node --test \"scripts/**/*.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
